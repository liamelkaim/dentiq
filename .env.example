# Copy to .env and fill in. Never commit .env.

# Leave empty for local development: `pnpm dev` starts a local Postgres (PGlite) stored in ./.data/pglite.
# For a hosted Postgres, use: postgres://user:password@host:5432/dbname (and run the app with `pnpm dev:app`).
DATABASE_URL=

# Where uploaded documents are stored locally (private; ignored by git).
UPLOADS_DIR=./.data/uploads

# Only to try the production build (`pnpm build && pnpm start`) on your own computer without a hosted database.
# Never set this on a real server.
ALLOW_LOCAL_DATABASE=

# Random string of 32+ characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# The public URL of the app.
BETTER_AUTH_URL=http://localhost:3000

# Optional, comma-separated. When set, only these email domains may sign up (e.g. umontreal.ca).
# Left empty until the enrollment verification policy is decided.
ALLOWED_EMAIL_DOMAINS=

# Optional, comma-separated. These emails become approved administrators when they sign up
# (they still have to confirm the email). Use this to create the first admin.
ADMIN_EMAILS=

# Month (1-12) when the academic year starts. It decides which exam passes are "current-year" (this
# academic year's exams) and which are "previous-year". Empty = 8 (August). Confirm with your faculty calendar.
ACADEMIC_YEAR_START_MONTH=

# Vercel: private Blob store token. Never use a public store for course documents.
BLOB_READ_WRITE_TOKEN=
# Resend: use a verified sender/domain; the sandbox sender only sends to your own account.
RESEND_API_KEY=
EMAIL_FROM=

# Cloud integrations stay off locally even if the keys above are set. They run on Vercel automatically.
# To test one on your computer on purpose, set it to true. This may use real, possibly paid, services.
DENTIQ_ENABLE_BLOB=
DENTIQ_ENABLE_RESEND=

# Which request header carries the visitor's IP address, used by the sign-in / sign-up / verification-email limits.
# Only set it when a proxy YOU control overwrites that header (a header anyone can send lets an attacker dodge the limit).
# On Vercel it is x-forwarded-for automatically. Values: x-forwarded-for, x-real-ip, cf-connecting-ip, fly-client-ip, none.
# Empty = trust none (all visitors then share one counter per page, which is safe but coarse).
TRUSTED_IP_HEADER=
