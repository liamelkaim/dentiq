# Copy to .env and fill in. Never commit .env.

# Leave empty for local development: an embedded Postgres (PGlite) is stored in ./.data/pglite.
# For a hosted Postgres, use: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Random string of 32+ characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# The public URL of the app.
BETTER_AUTH_URL=http://localhost:3000

# Optional, comma-separated. When set, only these email domains may sign up (e.g. umontreal.ca).
# Left empty until the enrollment verification policy is decided.
ALLOWED_EMAIL_DOMAINS=

# Optional, comma-separated. These emails become approved administrators when they sign up
# (they still have to confirm the email). Use this to create the first admin.
ADMIN_EMAILS=
